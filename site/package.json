{
	"name": "misemphasis-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"docs:build": "node scripts/build-docs.mjs",
		"dev": "localslip claim misemphasis-site --port 5205 && node ../scripts/site-dev.mjs",
		"build": "node ../scripts/sync-skill-static.mjs && pnpm docs:build && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=misemphasis",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.38",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"overrides": {
			"sharp": "0.35.4",
			"cookie@<0.7.0": "0.7.2"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}
